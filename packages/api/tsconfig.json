{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "composite": true,
    "paths": {
      "@athenaeum/shared": ["../shared/src"]
    },
    "rootDir": "."
  },
  "include": ["src/**/*", "tests/**/*"],
  "references": [
    { "path": "../shared" }
  ]
}
